FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-flask-key

DATABASE_URL=postgresql://postgres:your-db-password@your-db-host.supabase.co:5432/postgres

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

JWT_SECRET=your-jwt-signing-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com

# Use an App Password here, not your primary password!
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
